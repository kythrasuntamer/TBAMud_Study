# Multi-line sections and record markers
sect_desc="Desc:\x0a"
sect_skil="Skil:\x0a"
sect_affs="Affs:\x0a"
sect_qest="Qest:\x0a"
sect_edes="EDes:\x0a"
sect_ades="ADes:\x0a"
end_skills="0 0\x0a"
end_affects="0 0 0 0 0 0 0 0\x0a"
end_string="~\x0a"
end_rent="$~\x0a"
record="#"
unique_record="#65535\x0a"
proto_record="#100\x0a"
comment_line="*"
newline="\x0a"
crlf="\x0d\x0a"
nul="\x00"
colour_code="@R"
tab_code="@@"

# Rent header: rentcode timed netcost gold account nitems
rent_header_rented="2 1792998627 0 480 0 0\x0a"
rent_header_crash="1 1793008125 0 50 0 0\x0a"

# Numbers at type boundaries
