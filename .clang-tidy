Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,
  portability-*,
  -bugprone-assignment-in-if-condition,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-inc-dec-in-conditions,
  -bugprone-integer-division,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-suspicious-string-compare,
  -bugprone-switch-missing-default-case,
  -bugprone-too-small-loop-variable,
  -clang-analyzer-deadcode.DeadStores,
  -clang-analyzer-optin.performance.Padding
# CERT C checks are enabled explicitly. Keep memory-safety, ownership,
# null-dereference, bounds, stream, resource, errno and insecure-API
# analyzers enabled so CERT-relevant defects are not hidden by legacy
# suppressions.
HeaderFilterRegex: 'src/.*'
# sizeof() of a pointer is almost always a bug here: a mechanical
# strcat -> strlcat(buf, src, sizeof(buf)) conversion on a char * parameter
# bounded the copy at 8 bytes and cut every text file to 7 characters.
# Report it, and fail the build on it.
CheckOptions:
  bugprone-sizeof-expression.WarnOnSizeOfPointer: true
WarningsAsErrors: 'bugprone-sizeof-expression'
